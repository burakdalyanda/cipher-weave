{
    "name": "burakdalyanda/cipher-weave",
    "description": "A seamless security layer for Laravel applications that automatically decrypts incoming requests and encrypts outgoing responses to ensure data integrity and confidentiality.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cipher",
        "weave",
        "encryption",
        "decryption",
        "laravel",
        "laravel-package",
        "laravel-encryption",
        "laravel-decryption",
        "response-encryption",
        "response-decryption",
        "request-encryption",
        "request-decryption"
    ],
    "authors": [
        {
            "name": "Burak Dalyanda",
            "email": "burak.dalyanda@hotmail.com",
            "homepage": "https://github.com/burakdalyanda",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/burakdalyanda/cipher-weave",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/encryption": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BurakDalyanda\\CipherWeave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BurakDalyanda\\CipherWeave\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "BurakDalyanda\\CipherWeave\\CipherWeaveServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "analyze": "phpstan analyse"
    }
}
